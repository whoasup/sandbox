{
  "name": "@sandbox/editor-core",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@sandbox/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@sandbox/ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "nx": {
    "name": "editor-core",
    "targets": {
      "typecheck": {
        "cache": true,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "libs/editor-core",
          "command": "vue-tsc --build --emitDeclarationOnly"
        }
      }
    }
  }
}
