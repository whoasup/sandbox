    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "lint:style": "stylelint \"**/*.{css,vue}\" --ignore-path .gitignore",
    "format": "prettier --write \"*.{js,mjs,cjs,ts}\" \"**/*.css\" --ignore-path .gitignore --ignore-path .prettierignore && nx run-many -t lint -- --fix && stylelint \"**/*.{css,vue}\" --fix --ignore-path .gitignore",
    "typecheck": "nx run-many -t typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
